generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  staff
  admin
  owner
}

enum OrgStatus {
  pending
  verified
  suspended
}

enum Plan {
  starter
  professional
  enterprise
}

enum AppointmentStatus {
  upcoming
  serving
  completed
  missed
  cancelled
  skipped
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  phone              String?
  password           String
  role               Role           @default(customer)
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  ownedOrganizations Organization[] @relation("OrgOwner")
  organization       Organization?  @relation("OrgStaff", fields: [organizationId], references: [id])
  organizationId     String?
  appointments       Appointment[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  category     String
  address      String
  state        String
  lga          String
  openTime     String
  closeTime    String
  contactEmail String
  contactPhone String?
  plan         Plan          @default(professional)
  status       OrgStatus     @default(pending)
  queuePaused  Boolean       @default(false)
  owner        User          @relation("OrgOwner", fields: [ownerId], references: [id])
  ownerId      String
  staff        User[]        @relation("OrgStaff")
  services     Service[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id              String        @id @default(uuid())
  name            String
  durationMinutes Int           @default(15)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  appointments    Appointment[]

  @@unique([organizationId, name])
}

model Appointment {
  id             String            @id @default(uuid())
  queueNumber    Int
  date           String
  time           String
  status         AppointmentStatus @default(upcoming)
  checkedIn      Boolean           @default(false)
  customer       User              @relation(fields: [customerId], references: [id])
  customerId     String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  organizationId String
  service        Service           @relation(fields: [serviceId], references: [id])
  serviceId      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, date, queueNumber])
  @@index([customerId])
}
